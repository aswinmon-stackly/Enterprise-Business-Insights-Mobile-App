# Copy this file to `.env` (which is git-ignored) and fill in YOUR values.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/business_insights

# Optional: calendar dates (Today, This Month, custom ranges, daily buckets) are interpreted in this IANA time zone.
# BUSINESS_TIMEZONE=Asia/Kolkata
